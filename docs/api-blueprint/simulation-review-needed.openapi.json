          },
          {
            "name": "expectedDatasetVersion",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ApiResponse; data is the named DTO.",
            "headers": {
              "Cache-Control": {
                "description": "no-store",
