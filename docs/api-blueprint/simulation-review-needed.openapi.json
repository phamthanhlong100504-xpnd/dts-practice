{
  "openapi": "3.0.3",
  "info": {
    "title": "DTS Card02 and completed read-only replay",
    "version": "2026-11-02.v1",
    "description": "Reviewed source contract, not a live Swagger export or proof that candidate/runtime tests have passed. Existing Card01 learning/bookmark APIs are unchanged."
  },
  "servers": [
    {
      "url": "http://localhost:8888/api/practice/v1"
    },
    {
      "url": "http://localhost:8087/api/v1"
    }
  ],
  "security": [
    {
      "IdentityBearer": []
    }
  ],
  "paths": {
    "/simulations/review-needed/overview": {
      "get": {
        "operationId": "getSimulationReviewOverview",
        "summary": "Global need-review overview",
        "parameters": [
          {
            "name": "licenseClass",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Code from existing license catalogue; required by business validation."
            }
          },
          {
            "name": "bankVersion",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ApiResponse; data is the named DTO.",
            "headers": {
              "Cache-Control": {
                "description": "no-store",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewOverviewResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query, UUID or version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid access JWT",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/AuthErrorResponse"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Missing permission or unsupported license",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/AuthErrorResponse"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Unknown source/attempt or attempt owned by another user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "SIMULATION_REVIEW_CHANGED, SIMULATION_REPLAY_NOT_READY, or SIMULATION_BANK_CHANGED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Dependency/media unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-dts-required-permissions": [
          "simulations:read"
        ]
      }
    },
    "/simulations/review-needed": {
      "get": {
        "operationId": "getSimulationReviewNeeded",
