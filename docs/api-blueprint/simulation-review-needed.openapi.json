          },
          "scoringVersion": {
            "type": "string"
          },
          "practicedScenarios": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 120
          },
          "totalNeedReview": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 120
          },
          "chapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewChapter"
            }
          },
          "datasetVersion": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "scope",
          "scoringVersion",
          "practicedScenarios",
          "totalNeedReview",
          "chapters",
          "datasetVersion"
        ]
      },
      "ReviewItem": {
        "type": "object",
