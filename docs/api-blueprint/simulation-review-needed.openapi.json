  "components": {
    "securitySchemes": {
      "IdentityBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Scope": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "licenseClass": {
            "type": "string"
          },
          "bankVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
          }
        },
        "required": [
          "userId",
          "licenseClass",
          "bankVersion"
        ]
      },
      "ReviewChapter": {
        "type": "object",
        "properties": {
          "chapterId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 6
          },
          "chapterNumber": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 6
          },
          "chapterName": {
            "type": "string"
          },
          "needReviewCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "required": [
          "chapterId",
          "chapterNumber",
          "chapterName",
          "needReviewCount"
        ]
      },
      "ReviewOverview": {
        "type": "object",
        "properties": {
