          "totalElements": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "required": [
          "number",
          "size",
          "totalElements",
          "totalPages"
        ]
      },
      "ReviewPage": {
        "type": "object",
        "properties": {
