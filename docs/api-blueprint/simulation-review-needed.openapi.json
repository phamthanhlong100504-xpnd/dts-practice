            "type": "string",
            "format": "uuid"
          },
          "scenarioNumber": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 120
          },
          "chapterId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 6
          },
          "chapterNumber": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 6
          },
          "chapterName": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "durationMs": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "thumbnailUrl": {
            "type": "string",
            "format": "uri"
          },
          "thumbnailExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "bestScore": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 4
          },
          "maxScore": {
            "type": "integer",
            "format": "int32",
            "enum": [
              5
            ]
          },
          "isPracticed": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "isBookmarked": {
            "type": "boolean"
          },
          "completedAttemptCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        },
        "required": [
          "scenarioId",
          "scenarioNumber",
          "chapterId",
          "chapterNumber",
          "chapterName",
          "title",
          "durationMs",
          "thumbnailUrl",
          "thumbnailExpiresAt",
          "bestScore",
          "maxScore",
          "isPracticed",
          "isBookmarked",
          "completedAttemptCount"
